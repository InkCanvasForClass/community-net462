<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.HomeDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d"

      Title="{x:Static props:HomeStrings.Home_Title}">

    <ui:Page.Resources>
                <!-- 仪表盘卡片：仿 PowerToys Dashboard Card -->
                <Style x:Key="DashboardCardStyle" TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorDefaultBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style x:Key="DashboardCardTitleStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Margin" Value="16,0,0,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="DashboardCardDividerStyle" TargetType="Rectangle">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Fill" Value="{DynamicResource {x:Static ui:ThemeKeys.DividerStrokeColorDefaultBrushKey}}" />
                </Style>
                <!-- 快速访问磁贴 -->
                <Style x:Key="QuickAccessTileStyle" TargetType="Border">
                    <Setter Property="Height" Value="92" />
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <!-- 快捷键键帽 -->
                <Style x:Key="KeyChipStyle" TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Padding" Value="6,2" />
                    <Setter Property="Margin" Value="3,0,0,0" />
                    <Setter Property="MinWidth" Value="24" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <!-- 快捷键行底部分隔线 -->
                <Style x:Key="ShortcutRowStyle" TargetType="Border">
                    <Setter Property="MinHeight" Value="38" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.DividerStrokeColorDefaultBrushKey}}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Padding" Value="12,0" />
                </Style>
                <!-- 收藏夹行 -->
                <Style x:Key="FavouriteRowStyle" TargetType="Border">
                    <Setter Property="Padding" Value="12,6" />
                    <Setter Property="MinHeight" Value="36" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.ControlFillColorSecondaryBrushKey}}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
    </ui:Page.Resources>

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="4">

                    <!-- ==================== PowerToys 风格仪表盘 ==================== -->
                    <Grid Margin="0,24,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 顶栏 -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AppBanner"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Cursor="Hand"
                                    Padding="4"
                                    HorizontalAlignment="Left"
                                    MouseLeftButtonUp="HomeBanner_Click">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Image Source="\Resources\icc.ico" Width="32" Height="32"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <ikw:SimpleStackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="Ink Canvas" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AppVersionText" Text=""
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </ikw:SimpleStackPanel>
                                </ikw:SimpleStackPanel>
                            </Border>

                            <ikw:SimpleStackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Padding="10,6" Click="BtnBackToOldUI_Click"
                                        Content="{x:Static props:HomeStrings.Home_BackToOldUI}" />
                                <Button Width="36" Height="36" Padding="0"
                                        Tag="UpdatePage" Click="QuickNavCard_Click"
                                        ToolTipService.ToolTip="{x:Static props:NotificationStrings.Type_Update}">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Sync}" FontSize="16" />
                                </Button>
                                <Button Width="36" Height="36" Padding="0"
                                        Tag="NotificationCenterPage" Click="QuickNavCard_Click"
                                        ToolTipService.ToolTip="{x:Static props:NavStrings.Nav_NotificationCenter}">
                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Message}" FontSize="16" />
                                </Button>
                            </ikw:SimpleStackPanel>
                        </Grid>

                        <!-- 主体 -->
                        <Grid x:Name="DashboardBodyGrid" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LeftColumn" Width="*" />
                                <ColumnDefinition x:Name="RightColumn" Width="Auto" MinWidth="400" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ikw:SimpleStackPanel x:Name="DashboardLeft" Grid.Row="0" Grid.Column="0" Spacing="16">
                                <!-- 快速访问 -->
                                <Border Style="{StaticResource DashboardCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" MinHeight="44">
                                            <TextBlock Style="{StaticResource DashboardCardTitleStyle}"
                                                       Text="{x:Static props:HomeStrings.Home_QuickAccess}" />
                                        </Grid>
                                        <Rectangle Grid.Row="1" Style="{StaticResource DashboardCardDividerStyle}" />
                                        <UniformGrid Grid.Row="2" Columns="4" Rows="2" Margin="8,8,8,12">
                                            <Border Style="{StaticResource QuickAccessTileStyle}" Tag="StartupPage" MouseLeftButtonUp="QuickNavCard_Click">
                                                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Play}" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Static props:StartupStrings.Start}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="88" HorizontalAlignment="Center" />
                                                </ikw:SimpleStackPanel>
                                            </Border>
                                            <Border Style="{StaticResource QuickAccessTileStyle}" Tag="BoardPage" MouseLeftButtonUp="QuickNavCard_Click">
                                                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Edit}" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Static props:NavStrings.Nav_BoardPage}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="88" HorizontalAlignment="Center" />
                                                </ikw:SimpleStackPanel>
                                            </Border>
                                            <Border Style="{StaticResource QuickAccessTileStyle}" Tag="FloatingBarPage" MouseLeftButtonUp="QuickNavCard_Click">
                                                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Rename}" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Static props:NavStrings.Nav_FloatingBar}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="88" HorizontalAlignment="Center" />
                                                </ikw:SimpleStackPanel>
                                            </Border>
                                            <Border Style="{StaticResource QuickAccessTileStyle}" Tag="TimerPage" MouseLeftButtonUp="QuickNavCard_Click">
                                                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Recent}" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Static props:NavStrings.Nav_Timer}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="88" HorizontalAlignment="Center" />
                                                </ikw:SimpleStackPanel>
                                            </Border>
                                            <Border Style="{StaticResource QuickAccessTileStyle}" Tag="RollCallPage" MouseLeftButtonUp="QuickNavCard_Click">
                                                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.People}" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Static props:RandomStrings.Random_Title}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="88" HorizontalAlignment="Center" />
                                                </ikw:SimpleStackPanel>
                                            </Border>
                                            <Border Style="{StaticResource QuickAccessTileStyle}" Tag="ScreenTouchPage" MouseLeftButtonUp="QuickNavCard_Click">
                                                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.TouchPointer}" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Static props:NavStrings.Nav_ScreenTouch}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="88" HorizontalAlignment="Center" />
                                                </ikw:SimpleStackPanel>
                                            </Border>
                                            <Border Style="{StaticResource QuickAccessTileStyle}" Tag="HotkeyPage" MouseLeftButtonUp="QuickNavCard_Click">
                                                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.KeyboardStandard}" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Static props:NavStrings.Nav_Shortcuts}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="88" HorizontalAlignment="Center" />
                                                </ikw:SimpleStackPanel>
                                            </Border>
                                            <Border Style="{StaticResource QuickAccessTileStyle}" Tag="PluginPage" MouseLeftButtonUp="QuickNavCard_Click">
                                                <ikw:SimpleStackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Puzzle}" FontSize="24" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Static props:NavStrings.Nav_Plugins}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="88" HorizontalAlignment="Center" />
                                                </ikw:SimpleStackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </Grid>
                                </Border>

                                <!-- 快捷方式 -->
                                <Border Style="{StaticResource DashboardCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" MinHeight="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource DashboardCardTitleStyle}"
                                                       Text="{x:Static props:NavStrings.Nav_Shortcuts}" />
                                            <Button Grid.Column="1" Margin="0,0,8,0" Padding="8,4" VerticalAlignment="Center"
                                                    Content="{x:Static props:HomeStrings.Home_ViewAll}"
                                                    Tag="HotkeyPage" Click="QuickNavCard_Click" />
                                        </Grid>
                                        <Rectangle Grid.Row="1" Style="{StaticResource DashboardCardDividerStyle}" />
                                        <ItemsControl x:Name="ShortcutItemsControl" Grid.Row="2" Margin="0,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ShortcutRowStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Keys}"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Style="{StaticResource KeyChipStyle}">
                                                                            <TextBlock Text="{Binding}" FontSize="12"
                                                                                       HorizontalAlignment="Center"
                                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </ikw:SimpleStackPanel>

                            <!-- 收藏夹 -->
                            <Border x:Name="FavouritesCard" Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource DashboardCardStyle}"
                                    VerticalAlignment="Top" Margin="16,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" MinHeight="44">
                                        <TextBlock Style="{StaticResource DashboardCardTitleStyle}"
                                                   Text="{x:Static props:NavStrings.Nav_Favourites}" />
                                    </Grid>
                                    <Rectangle Grid.Row="1" Style="{StaticResource DashboardCardDividerStyle}" />
                                    <Grid Grid.Row="2" Margin="8,8,8,8">
                                        <TextBlock x:Name="FavouritesEmpty" Margin="12"
                                                   Text="{x:Static props:NavStrings.Nav_Favourites_Empty}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" HorizontalAlignment="Left" />
                                        <StackPanel x:Name="FavouritesList" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <!-- ==================== 仪表盘结束 ==================== -->

                    <Rectangle Height="24" />

                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
