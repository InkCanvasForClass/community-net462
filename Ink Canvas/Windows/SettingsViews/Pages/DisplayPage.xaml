<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Windows.SettingsViews.Pages.DisplayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
      xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
      xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
      mc:Ignorable="d"
      Title="Display">

    <ScrollViewer PanningMode="VerticalFirst">
        <Grid Margin="59,0,59,0">
            <FrameworkElement.Resources>
                <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>
                <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                    BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                    TargetType="TextBlock">
                    <Style.Setters>
                        <Setter Property="Margin" Value="1,30,0,6" />
                    </Style.Setters>
                </Style>
            </FrameworkElement.Resources>
            <Grid>
                <ikw:SimpleStackPanel MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="{StaticResource SettingsCardSpacing}">

                    <!-- Theme -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:ThemeStrings.Theme_GroupTitle}" />

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_Label}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Pinned}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxTheme"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxTheme_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Light}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Dark}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_System}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_WindowBackdrop}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.FullScreen}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxWindowBackdrop"
                                  SelectionChanged="ComboBoxWindowBackdrop_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_None}" Tag="None" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Mica}" Tag="Mica" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic}" Tag="Acrylic" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Tabbed}" Tag="Tabbed" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Transient}" Tag="Transient" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic10}" Tag="Acrylic10" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_WindowBackdrop_Acrylic11}" Tag="Acrylic11" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_LanguageLabel}"
                            Description="{x:Static props:ThemeStrings.Theme_Language_RestartHint}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Globe}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxLanguage"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxLanguage_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_System}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Language_ChineseSimplified}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Language_English}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Language_MemeChinese}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <!-- Clock -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="时钟" />

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.AppearancePanel_24HourTimeFormat}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Glyph="&#xE917;" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxTimeFormat"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxTimeFormat_SelectionChanged">
                            <ComboBoxItem Content="12h" />
                            <ComboBoxItem Content="24h" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <!-- Quick Panel -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="快捷面板" />

                    <controls:LabeledSettingsCard x:Name="CardEnableQuickPanel"
                            Header="{x:Static props:ThemeStrings.Theme_EnableQuickPanel}"
                            Icon="{x:Static ui:SegoeFluentIcons.Pinned}"
                            SwitchName="ToggleSwitchEnableQuickPanel"
                            Toggled="ToggleSwitchEnableQuickPanel_Toggled" />

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_QuickPanelBottomOffset}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="QuickPanelBottomOffsetText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="QuickPanelBottomOffsetSlider" Minimum="-600"
                                    Maximum="600" Width="200"
                                    IsSnapToTickEnabled="True" Value="-150" TickFrequency="10"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="QuickPanelBottomOffsetSlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_UnfoldButtonIcon}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.ChevronRight}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ComboBoxUnFoldBtnImg"
                                  SelectedIndex="0"
                                  SelectionChanged="ComboBoxUnFoldBtnImg_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_UnfoldIcon_ClassicArrow}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_UnfoldIcon_ClassicPen}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_UnfoldIcon_Stripe}" />
                        </ComboBox>
                    </ui:SettingsCard>

                    <controls:LabeledSettingsCard x:Name="CardAllowDragSidePanel"
                            Header="{x:Static props:ThemeStrings.Theme_AllowDragSidePanel}"
                            Icon="{x:Static ui:SegoeFluentIcons.Touch}"
                            SwitchName="ToggleSwitchAllowDragSidePanel"
                            Toggled="ToggleSwitchAllowDragSidePanel_Toggled" />

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_QuickPanelOpacity}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.View}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="QuickPanelOpacityText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="QuickPanelOpacitySlider" Minimum="0.1"
                                    Maximum="1.0" Width="200"
                                    IsSnapToTickEnabled="True" Value="1.0" TickFrequency="0.1"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="QuickPanelOpacitySlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <controls:LabeledSettingsCard x:Name="CardAutoCollapseQuickPanel"
                            Header="{x:Static props:ThemeStrings.Theme_AutoCollapseQuickPanel}"
                            Icon="{x:Static ui:SegoeFluentIcons.ChevronDown}"
                            SwitchName="ToggleSwitchAutoCollapseQuickPanel"
                            Toggled="ToggleSwitchAutoCollapseQuickPanel_Toggled" />

                    <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_AutoCollapseQuickPanelDelay}"
                            IsEnabled="{Binding ElementName=ToggleSwitchAutoCollapseQuickPanel, Path=IsOn}">
                        <ui:SettingsCard.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.History}" />
                        </ui:SettingsCard.HeaderIcon>
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="AutoCollapseDelayText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                            <Slider x:Name="AutoCollapseDelaySlider" Minimum="1"
                                    Maximum="10" Width="200"
                                    IsSnapToTickEnabled="True" Value="3.0" TickFrequency="1"
                                    TickPlacement="None" AutoToolTipPlacement="None"
                                    ValueChanged="AutoCollapseDelaySlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <!-- Splash Screen -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="启动画面" />

                    <ui:SettingsExpander Header="{x:Static props:ThemeStrings.Theme_EnableSplash}"
                            Description="{x:Static props:ThemeStrings.Theme_EnableSplash}"
                            IsExpanded="{Binding IsOn, ElementName=ToggleSwitchEnableSplashScreen, Mode=OneWay}">
                        <ui:SettingsExpander.HeaderIcon>
                            <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Photo}" />
                        </ui:SettingsExpander.HeaderIcon>
                        <ui:ToggleSwitch x:Name="ToggleSwitchEnableSplashScreen"
                                        Toggled="ToggleSwitchEnableSplashScreen_Toggled" />
                        <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_SplashStyle}">
                                <ComboBox x:Name="ComboBoxSplashScreenStyle"
                                          SelectedIndex="1"
                                          SelectionChanged="ComboBoxSplashScreenStyle_SelectionChanged">
                                    <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Random}" />
                                    <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Seasonal}" />
                                    <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Spring}" />
                                    <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Summer}" />
                                    <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Autumn}" />
                                    <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Winter}" />
                                    <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Horse}" />
                                    <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_Splash_Custom}" />
                                </ComboBox>
                            </ui:SettingsCard>
                            <ui:SettingsCard x:Name="CardCustomSplashImage"
                                             Header="{x:Static props:ThemeStrings.Theme_CustomSplashImage}"
                                             Description="{x:Static props:ThemeStrings.Theme_CustomSplashImage_Desc}"
                                             Visibility="Collapsed">
                                <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="TextBlockCustomSplashPath"
                                               Text="{x:Static props:ThemeStrings.Theme_CustomSplash_NotSelected}"
                                               VerticalAlignment="Center"
                                               MaxWidth="200"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="Gray"/>
                                    <Button x:Name="ButtonBrowseCustomSplash"
                                            Content="{x:Static props:StorageStrings.Storage_PathBrowse}"
                                            Padding="10,3"
                                            Click="ButtonBrowseCustomSplash_Click"/>
                                    <Button x:Name="ButtonClearCustomSplash"
                                            Content="{x:Static props:ThemeStrings.Theme_Clear}"
                                            Padding="10,3"
                                            Click="ButtonClearCustomSplash_Click"/>
                                </ikw:SimpleStackPanel>
                            </ui:SettingsCard>
                            <ui:SettingsCard x:Name="CardCustomSplashTextPosition"
                                             Header="{x:Static props:ThemeStrings.Theme_CustomSplashTextPosition}"
                                             Description="{x:Static props:ThemeStrings.Theme_CustomSplashTextPosition_Desc}"
                                             Visibility="Collapsed">
                                <Border CornerRadius="4"
                                        BorderThickness="1"
                                        BorderBrush="#30808080"
                                        Background="Transparent"
                                        Width="110"
                                        Height="32">
                                    <Grid ClipToBounds="True">
                                        <Border x:Name="SelectionIndicator"
                                                CornerRadius="3"
                                                Background="#200078D7"
                                                BorderBrush="#800078D7"
                                                BorderThickness="1"
                                                Width="34"
                                                Height="28"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="1,1,0,1"
                                                Panel.ZIndex="1">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="IndicatorTranslateTransform" X="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <ikw:SimpleStackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border x:Name="BorderTextAlignLeft"
                                                    Width="36" Height="30"
                                                    PreviewMouseLeftButtonDown="BorderTextAlign_Click"
                                                    Tag="0"
                                                    Cursor="Hand"
                                                    Panel.ZIndex="2">
                                                <Canvas>
                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AlignLeft}" FontSize="14"
                                                                 Canvas.Left="11" Canvas.Top="8"
                                                                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                                </Canvas>
                                            </Border>
                                            <Border x:Name="BorderTextAlignCenter"
                                                    Width="36" Height="30"
                                                    PreviewMouseLeftButtonDown="BorderTextAlign_Click"
                                                    Tag="1"
                                                    Cursor="Hand"
                                                    Panel.ZIndex="2">
                                                <Canvas>
                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AlignCenter}" FontSize="14"
                                                                 Canvas.Left="11" Canvas.Top="8"
                                                                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                                </Canvas>
                                            </Border>
                                            <Border x:Name="BorderTextAlignRight"
                                                    Width="36" Height="30"
                                                    PreviewMouseLeftButtonDown="BorderTextAlign_Click"
                                                    Tag="2"
                                                    Cursor="Hand"
                                                    Panel.ZIndex="2">
                                                <Canvas>
                                                    <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.AlignRight}" FontSize="14"
                                                                 Canvas.Left="11" Canvas.Top="8"
                                                                 Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                                </Canvas>
                                            </Border>
                                        </ikw:SimpleStackPanel>
                                    </Grid>
                                </Border>
                            </ui:SettingsCard>
                        </ui:SettingsExpander.Items>
                    </ui:SettingsExpander>

                    <!-- Mini Whiteboard -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Static props:FloatingBarStrings.FloatingBar_MiniWhiteboard}" />

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchMiniWhiteboardEnabled"
                        Header="{x:Static props:FloatingBarStrings.MiniWhiteboard_Settings_Enable}"
                        Icon="{x:Static ui:SegoeFluentIcons.Edit}"
                        IsOn="True"
                        Toggled="ToggleSwitchMiniWhiteboardEnabled_Toggled" />

                    <controls:LabeledSettingsCard x:Name="ToggleSwitchMiniWhiteboardSyncPPT"
                        Header="{x:Static props:FloatingBarStrings.MiniWhiteboard_Settings_SyncPPT}"
                        Icon="{x:Static ui:SegoeFluentIcons.Slideshow}"
                        IsOn="True"
                        Toggled="ToggleSwitchMiniWhiteboardSyncPPT_Toggled" />

                    <ui:SettingsCard Header="{x:Static props:FloatingBarStrings.MiniWhiteboard_Settings_DefaultSize}">
                        <ikw:SimpleStackPanel Orientation="Vertical" Spacing="8">
                            <TextBlock x:Name="MiniWhiteboardSizeText"
                                       VerticalAlignment="Center" FontFamily="Consolas" />
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="W" Width="16" VerticalAlignment="Center" />
                                <Slider x:Name="MiniWhiteboardWidthSlider"
                                        Minimum="200" Maximum="1200" Width="200"
                                        IsSnapToTickEnabled="True" TickFrequency="10"
                                        TickPlacement="None"
                                        ValueChanged="MiniWhiteboardWidthSlider_ValueChanged" />
                            </ikw:SimpleStackPanel>
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="H" Width="16" VerticalAlignment="Center" />
                                <Slider x:Name="MiniWhiteboardHeightSlider"
                                        Minimum="150" Maximum="900" Width="200"
                                        IsSnapToTickEnabled="True" TickFrequency="10"
                                        TickPlacement="None"
                                        ValueChanged="MiniWhiteboardHeightSlider_ValueChanged" />
                            </ikw:SimpleStackPanel>
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <ui:SettingsCard Header="{x:Static props:FloatingBarStrings.MiniWhiteboard_Settings_Opacity}">
                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="MiniWhiteboardOpacityText"
                                       VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right" />
                            <Slider x:Name="MiniWhiteboardOpacitySlider"
                                    Minimum="0.3" Maximum="1"
                                    Width="200"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="0.05" TickPlacement="None"
                                    ValueChanged="MiniWhiteboardOpacitySlider_ValueChanged" />
                        </ikw:SimpleStackPanel>
                    </ui:SettingsCard>

                    <Rectangle Height="48" />
                </ikw:SimpleStackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</ui:Page>
