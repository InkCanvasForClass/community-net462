<ui:Page x:Class="Ink_Canvas.Windows.SettingsViews.Pages.AutomationWorkflowPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend"
         xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
         xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
         xmlns:c="clr-namespace:Ink_Canvas.Converter"
         xmlns:props="clr-namespace:Ink_Canvas.Properties"
         xmlns:sys="clr-namespace:System;assembly=mscorlib"
         xmlns:dd="urn:gong-wpf-dragdrop"
         xmlns:touch="clr-namespace:Ink_Canvas.Helpers"
         mc:Ignorable="d"
         d:DesignHeight="800"
         d:DesignWidth="1200"
         Title="{x:Static props:AutomationStrings.Automation_Title}">

    <Page.Resources>
        <c:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <c:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>

        <!-- 状态指示器样式（与 ClassIsland RulesetControl 一致） -->
        <Style TargetType="Ellipse" x:Key="StateIndicatorStyle">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State, Mode=OneWay}" Value="2">
                    <Setter Property="Fill" Value="Green"/>
                    <Setter Property="ToolTip" Value="{x:Static props:AutomationStrings.AutoWf_StateSatisfied}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State, Mode=OneWay}" Value="1">
                    <Setter Property="Fill" Value="IndianRed"/>
                    <Setter Property="ToolTip" Value="{x:Static props:AutomationStrings.AutoWf_StateNotSatisfied}"/>
                </DataTrigger>
            </Style.Triggers>
            <Setter Property="Fill" Value="DarkGray"/>
            <Setter Property="ToolTip" Value="{x:Static props:AutomationStrings.AutoWf_StateUnknown}"/>
        </Style>

        <local:RulesetLogicalModeToIntConverter x:Key="LogicalModeToIntConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：导航列表 ==================== -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="{x:Static props:AutomationStrings.Automation_Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <!-- 添加按钮 -->
            <Button Grid.Row="1" x:Name="BtnAddWorkflow"
                    Content="{x:Static props:AutomationStrings.AutoWf_AddWorkflow}"
                    Click="BtnAddWorkflow_Click"
                    Padding="12,6" Margin="0,0,0,8" HorizontalAlignment="Left"/>

            <!-- 导航列表 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="NavigationListBox"
                         SelectionChanged="NavigationListBox_SelectionChanged"
                         HorizontalContentAlignment="Stretch"
                         dd:DragDrop.IsDragSource="True"
                         dd:DragDrop.IsDropTarget="True"
                         touch:TouchAwareDragDropHelper.IsEnabled="True">
                    <!-- 工作流项通过 DataTemplate 渲染 -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                        Background="Transparent" Padding="2,4" Margin="0,0,4,0"
                                        Cursor="SizeAll">
                                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Rename_20_Regular}" Width="16" Height="16"
                                                 VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding ActionSet.Name}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:ToggleSwitch IsOn="{Binding ActionSet.IsEnabled}"
                                                     Toggled="ToggleWorkflowEnabled_Toggled"
                                                     Width="44" Height="24" Margin="0,0,4,0"/>
                                    <Button Content="⧉" Click="BtnDuplicateWorkflow_Click"
                                            Padding="4,0" Tag="{Binding}" Margin="0,0,4,0"
                                            ToolTip="{x:Static props:AutomationStrings.AutoWf_Copy}"/>
                                    <Button Content="✕" Click="BtnRemoveWorkflow_Click"
                                            Padding="4,0" Tag="{Binding}"
                                            ToolTip="{x:Static props:AutomationStrings.AutoWf_Delete}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>

        <!-- ==================== 右侧：内容区域 ==================== -->
        <Grid Grid.Column="2">


            <!-- ========== 工作流编辑器面板 ========== -->
            <ScrollViewer x:Name="WorkflowEditorPanel" Visibility="Collapsed" Padding="16,8">
                <StackPanel DataContext="{Binding SelectedWorkflow, Mode=OneWay}">
                    <!-- 禁用时整体半透明 -->
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActionSet.IsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.56"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- ===== 顶部：名称 + 选项 ===== -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_Name}" FontWeight="Medium" Margin="0,0,0,4"/>
                                <TextBox x:Name="TextBoxWorkflowName"
                                         Padding="8,6" MinWidth="200"
                                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                         BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                                <CheckBox x:Name="CheckBoxIsRevertEnabled" Content="{x:Static props:AutomationStrings.AutoWf_EnableRevert}" Margin="0,0,0,8"
                                          Checked="CheckBoxIsRevertEnabled_Changed"
                                          Unchecked="CheckBoxIsRevertEnabled_Changed"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnInvokeAction" Content="{x:Static props:AutomationStrings.AutoWf_Invoke}" Padding="12,4" Margin="0,0,8,0" Click="BtnInvokeAction_Click"/>
                                    <Button x:Name="BtnRevertAction" Content="{x:Static props:AutomationStrings.AutoWf_Revert}" Padding="12,4" Click="BtnRevertAction_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== 触发器编辑区 ===== -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 标题 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Important_20_Regular}" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_WhenEvents}" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 触发器列表 -->
                            <ItemsControl x:Name="TriggersItemsControl" Margin="0,0,0,8"
                                          dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True"
                                          touch:TouchAwareDragDropHelper.IsEnabled="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="4" Padding="8" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 拖动按钮 -->
                                                <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                                        Background="Transparent" Padding="2,4" Margin="0,0,4,0"
                                                        Cursor="SizeAll">
                                                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ReOrderDotsVertical_20_Filled}" FontSize="10"
                                                               VerticalAlignment="Center" Opacity="0.45"/>
                                                </Border>

                                                <!-- 删除按钮 -->
                                                <Button Grid.Column="1" Content="✕" Padding="4,0"
                                                        Margin="0,0,8,0" Click="BtnRemoveTrigger_Click"
                                                        Tag="{Binding}" ToolTip="{x:Static props:AutomationStrings.AutoWf_Delete}"/>

                                                <!-- 触发器类型选择 -->
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{x:Static local:AutomationWorkflowPage.RegisteredTriggersList}"
                                                          DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                          SelectedValue="{Binding Id, Mode=TwoWay}"
                                                          SelectionChanged="ComboBoxTriggerType_SelectionChanged"
                                                          Tag="{Binding}" Padding="8,6" MinWidth="150"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 添加触发器 -->
                            <Button Content="{x:Static props:AutomationStrings.AutoWf_AddTrigger}" Click="BtnAddTrigger_Click"
                                    Padding="12,6" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== 条件编辑区（规则集） ===== -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 标题 + 启用开关 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:ToggleSwitch x:Name="ToggleIsConditionEnabled" Margin="0,0,8,0"
                                                 Toggled="ToggleIsConditionEnabled_Toggled"/>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Tag_20_Regular}" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_AndConditions}" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 条件禁用提示 -->
                            <TextBlock x:Name="ConditionDisabledHint"
                                       Text="{x:Static props:AutomationStrings.AutoWf_ConditionDisabledHint}" Opacity="0.5" Margin="0,0,0,8"/>

                            <!-- 条件编辑面板 -->
                            <StackPanel x:Name="ConditionEditorPanel">
                                <!-- 规则集级别控制 -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ComboBox x:Name="ComboBoxRulesetMode" Padding="8,6" Margin="0,0,8,0"
                                              SelectionChanged="ComboBoxRulesetMode_SelectionChanged">
                                        <ComboBoxItem Content="{x:Static props:AutomationStrings.AutoWf_AnyGroup}"/>
                                        <ComboBoxItem Content="{x:Static props:AutomationStrings.AutoWf_AllGroups}"/>
                                    </ComboBox>
                                    <CheckBox x:Name="CheckBoxRulesetReversed" Content="{x:Static props:AutomationStrings.AutoWf_Reverse}"
                                              Margin="0,0,8,0" VerticalAlignment="Center"
                                              Checked="CheckBoxRulesetReversed_Changed"
                                              Unchecked="CheckBoxRulesetReversed_Changed"/>
                                    <Button Content="{x:Static props:AutomationStrings.AutoWf_AddGroup}" Padding="8,4" VerticalAlignment="Center"
                                            Click="BtnAddRuleGroup_Click"/>
                                    <Ellipse x:Name="EllipseRulesetState" Width="10" Height="10"
                                             Margin="8,0,0,0" VerticalAlignment="Center"
                                             Fill="DarkGray"/>
                                </WrapPanel>

                                <!-- 条件组列表 -->
                                <ItemsControl x:Name="RuleGroupsItemsControl"
                                              dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True"
                                              touch:TouchAwareDragDropHelper.IsEnabled="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="8"
                                                    Margin="0,4" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 拖动按钮 -->
                                                    <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                                            Background="Transparent" Padding="2,4" Margin="0,0,4,0"
                                                            Cursor="SizeAll">
                                                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ReOrderDotsVertical_20_Filled}" FontSize="10"
                                                                   VerticalAlignment="Center" Opacity="0.45"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                    <!-- 条件组头部 -->
                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <ComboBox Padding="8,6" Margin="0,0,8,0"
                                                                  SelectedIndex="{Binding Mode, Converter={StaticResource LogicalModeToIntConverter}, Mode=TwoWay}"
                                                                  SelectionChanged="ComboBoxGroupMode_SelectionChanged"
                                                                  Tag="{Binding}">
                                                            <ComboBoxItem Content="{x:Static props:AutomationStrings.AutoWf_AnyRule}"/>
                                                            <ComboBoxItem Content="{x:Static props:AutomationStrings.AutoWf_AllRules}"/>
                                                        </ComboBox>
                                                        <CheckBox Content="{x:Static props:AutomationStrings.AutoWf_Reverse}" IsChecked="{Binding IsReversed}"
                                                                  Checked="CheckBoxGroupReversed_Changed"
                                                                  Unchecked="CheckBoxGroupReversed_Changed"
                                                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <Button Content="{x:Static props:AutomationStrings.AutoWf_AddRule}" Padding="6,2" Margin="0,0,8,0"
                                                                VerticalAlignment="Center" Click="BtnAddRuleToGroup_Click"
                                                                Tag="{Binding}"/>

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Ellipse Width="8" Height="8" Margin="0,0,4,0"
                                                                     Style="{StaticResource StateIndicatorStyle}"/>
                                                            <ui:ToggleSwitch IsOn="{Binding IsEnabled}"
                                                                             Toggled="CheckBoxGroupEnabled_Toggled"
                                                                             Width="44" Height="24" Margin="0,0,4,0"
                                                                             ToolTip="{x:Static props:AutomationStrings.AutoWf_EnableGroup}"/>
                                                            <Button Content="⧉" Padding="4,2" Margin="0,0,4,0"
                                                                    Click="BtnDuplicateGroup_Click" Tag="{Binding}" ToolTip="{x:Static props:AutomationStrings.AutoWf_Copy}"/>
                                                            <Button Content="✕" Padding="4,2"
                                                                    Click="BtnDeleteGroup_Click" Tag="{Binding}" ToolTip="{x:Static props:AutomationStrings.AutoWf_Delete}"/>
                                                        </StackPanel>
                                                    </WrapPanel>

                                                    <!-- 规则列表 -->
                                                    <ItemsControl ItemsSource="{Binding Rules}" Margin="4,0,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="220"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0" Content="✕" FontSize="10"
                                                                            Click="BtnRemoveRule_Click" Padding="4,1"
                                                                            Margin="0,0,4,0" Tag="{Binding}" ToolTip="{x:Static props:AutomationStrings.AutoWf_Delete}"/>
                                                                    <Ellipse Grid.Column="1" Width="8" Height="8"
                                                                             Margin="0,0,4,0" VerticalAlignment="Center"
                                                                             Style="{StaticResource StateIndicatorStyle}"/>
                                                                    <CheckBox Grid.Column="2" Content="{x:Static props:AutomationStrings.AutoWf_Reverse}"
                                                                              IsChecked="{Binding IsReversed}"
                                                                              Checked="CheckBoxRuleReversed_Changed"
                                                                              Unchecked="CheckBoxRuleReversed_Changed"
                                                                              Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <ComboBox Grid.Column="3"
                                                                              ItemsSource="{x:Static local:AutomationWorkflowPage.RegisteredRulesList}"
                                                                              DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                                              SelectedValue="{Binding Id, Mode=TwoWay}"
                                                                              SelectionChanged="ComboBoxRuleType_SelectionChanged"
                                                                              Tag="{Binding}" Padding="8,6"/>
                                                                        <local:AutomationSettingsPresenter Grid.Column="4"
                                                                                                           Margin="8,0,0,0"
                                                                                                           VerticalAlignment="Center"
                                                                                                           Item="{Binding}"
                                                                                                           SettingsChanged="RuleSettingsPresenter_SettingsChanged"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== 行动编辑区 ===== -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 标题 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Play_20_Regular}" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_Actions}" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 行动列表 -->
                            <ItemsControl x:Name="ActionsItemsControl" Margin="0,0,0,8"
                                          dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True"
                                          touch:TouchAwareDragDropHelper.IsEnabled="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="4" Padding="8" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 拖动按钮 -->
                                                <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                                        Background="Transparent" Padding="2,4" Margin="0,0,4,0"
                                                        Cursor="SizeAll">
                                                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ReOrderDotsVertical_20_Filled}" FontSize="10"
                                                               VerticalAlignment="Center" Opacity="0.45"/>
                                                </Border>

                                                <!-- 删除按钮 -->
                                                <Button Grid.Column="1" Content="✕" Padding="4,0"
                                                        Margin="0,0,8,0" Click="BtnRemoveAction_Click"
                                                        Tag="{Binding}" ToolTip="{x:Static props:AutomationStrings.AutoWf_Delete}"/>

                                                <!-- 行动类型选择 -->
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{x:Static local:AutomationWorkflowPage.RegisteredActionsList}"
                                                          DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                          SelectedValue="{Binding Id, Mode=TwoWay}"
                                                          SelectionChanged="ComboBoxActionType_SelectionChanged"
                                                          Tag="{Binding}" Padding="8,6" MinWidth="150"
                                                          VerticalAlignment="Center"/>
                                                <local:AutomationSettingsPresenter Grid.Column="3"
                                                                                   Margin="8,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Item="{Binding}"
                                                                                   SettingsChanged="ActionSettingsPresenter_SettingsChanged"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 添加行动 -->
                            <Button Content="{x:Static props:AutomationStrings.AutoWf_AddAction}" Click="BtnAddAction_Click"
                                    Padding="12,6" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== 恢复提示 ===== -->
                    <StackPanel x:Name="RevertHintPanel" Orientation="Horizontal" Margin="0,0,0,16" Opacity="0.6">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Stop_20_Regular}" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_AutoRevertHint}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 未选择工作流时的占位符 ========== -->
            <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Rename_20_Regular}" FontSize="48" HorizontalAlignment="Center" Opacity="0.4"/>
                <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_EmptyState}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.6"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:Page>
