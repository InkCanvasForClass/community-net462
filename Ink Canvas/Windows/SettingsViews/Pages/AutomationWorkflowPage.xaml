<ui:Page x:Class="Ink_Canvas.Windows.SettingsViews.Pages.AutomationWorkflowPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend"
         xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
         xmlns:ctrl="clr-namespace:Ink_Canvas.Windows.SettingsViews.Controls"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
         xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
         xmlns:c="clr-namespace:Ink_Canvas.Converter"
         xmlns:props="clr-namespace:Ink_Canvas.Properties"
         xmlns:sys="clr-namespace:System;assembly=mscorlib"
         xmlns:dd="urn:gong-wpf-dragdrop"
         xmlns:touch="clr-namespace:Ink_Canvas.Helpers"
         mc:Ignorable="d"
         d:DesignHeight="800"
         d:DesignWidth="1200"
         Title="{x:Static props:AutomationStrings.Automation_Title}">

    <Page.Resources>
        <c:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <c:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <sys:Double x:Key="SettingsCardSpacing">4</sys:Double>

        <!-- 紧凑的导航列表项：覆盖 iNKORE 默认的 Padding="12,9,12,12" 与 Left 对齐 -->
        <Style x:Key="NavListItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3,6,3"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="LayoutRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LayoutRoot" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="LayoutRoot" Property="Background"
                                        Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="220"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：导航列表 ==================== -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="{x:Static props:AutomationStrings.Automation_Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <!-- 类型选择 -->
            <ComboBox Grid.Row="1" x:Name="ComboBoxCategory" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                      SelectionChanged="ComboBoxCategory_SelectionChanged">
                <ComboBoxItem Content="{x:Static props:AutomationStrings.AutoWf_Category_Workflow}"/>
                <ComboBoxItem Content="{x:Static props:AutomationStrings.AutoWf_Category_StateGroup}"/>
                <ComboBoxItem Content="{x:Static props:AutomationStrings.AutoWf_Category_ActionGroup}"/>
            </ComboBox>

            <!-- 添加按钮 -->
            <Button Grid.Row="2" x:Name="BtnAddItem"
                    Content="{x:Static props:AutomationStrings.AutoWf_AddWorkflow}"
                    Click="BtnAddItem_Click"
                    Padding="12,6" Margin="0,0,0,8" HorizontalAlignment="Left"/>

            <!-- 导航列表 -->
            <Grid Grid.Row="3">
                    <!-- 工作流 -->
                    <ListBox x:Name="NavigationListBox"
                             ItemContainerStyle="{StaticResource NavListItemContainerStyle}"
                             SelectionChanged="NavigationListBox_SelectionChanged"
                             HorizontalContentAlignment="Stretch"
                             dd:DragDrop.IsDragSource="True"
                             dd:DragDrop.IsDropTarget="True"
                             touch:TouchAwareDragDropHelper.IsEnabled="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                            Background="Transparent" Padding="2,4" Margin="0,0,4,0"
                                            Cursor="SizeAll">
                                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Rename_20_Regular}" Width="16" Height="16"
                                                     VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding ActionSet.Name}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ToggleSwitch IsOn="{Binding ActionSet.IsEnabled}"
                                                         Toggled="ToggleWorkflowEnabled_Toggled"
                                                         MinWidth="0"
                                                         Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <Button Content="⧉" Click="BtnDuplicateWorkflow_Click"
                                                Padding="4,0" Tag="{Binding}" Margin="0,0,4,0"
                                                MinWidth="40" MinHeight="40" VerticalAlignment="Center"
                                                ToolTip="{x:Static props:AutomationStrings.AutoWf_Copy}"/>
                                        <Button Content="✕" Click="BtnRemoveWorkflow_Click"
                                                Padding="4,0" Tag="{Binding}"
                                                MinWidth="40" MinHeight="40" VerticalAlignment="Center"
                                                ToolTip="{x:Static props:AutomationStrings.AutoWf_Delete}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 状态组 -->
                    <ListBox x:Name="StateGroupsListBox" Visibility="Collapsed"
                             ItemContainerStyle="{StaticResource NavListItemContainerStyle}"
                             SelectionChanged="StateGroupsListBox_SelectionChanged"
                             HorizontalContentAlignment="Stretch"
                             dd:DragDrop.IsDragSource="True"
                             dd:DragDrop.IsDropTarget="True"
                             touch:TouchAwareDragDropHelper.IsEnabled="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                            Background="Transparent" Padding="2,4" Margin="0,0,4,0"
                                            Cursor="SizeAll">
                                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ReOrderDotsVertical_20_Filled}" FontSize="10"
                                                     VerticalAlignment="Center" Opacity="0.45"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="⧉" Click="BtnDuplicateStateGroup_Click"
                                                Padding="4,0" Tag="{Binding}" Margin="0,0,4,0"
                                                MinWidth="40" MinHeight="40" VerticalAlignment="Center"
                                                ToolTip="{x:Static props:AutomationStrings.AutoWf_Copy}"/>
                                        <Button Content="✕" Click="BtnRemoveStateGroup_Click"
                                                Padding="4,0" Tag="{Binding}"
                                                MinWidth="40" MinHeight="40" VerticalAlignment="Center"
                                                ToolTip="{x:Static props:AutomationStrings.AutoWf_Delete}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 动作组 -->
                    <ListBox x:Name="ActionGroupsListBox" Visibility="Collapsed"
                             ItemContainerStyle="{StaticResource NavListItemContainerStyle}"
                             SelectionChanged="ActionGroupsListBox_SelectionChanged"
                             HorizontalContentAlignment="Stretch"
                             dd:DragDrop.IsDragSource="True"
                             dd:DragDrop.IsDropTarget="True"
                             touch:TouchAwareDragDropHelper.IsEnabled="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                            Background="Transparent" Padding="2,4" Margin="0,0,4,0"
                                            Cursor="SizeAll">
                                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ReOrderDotsVertical_20_Filled}" FontSize="10"
                                                     VerticalAlignment="Center" Opacity="0.45"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="⧉" Click="BtnDuplicateActionGroup_Click"
                                                Padding="4,0" Tag="{Binding}" Margin="0,0,4,0"
                                                MinWidth="40" MinHeight="40" VerticalAlignment="Center"
                                                ToolTip="{x:Static props:AutomationStrings.AutoWf_Copy}"/>
                                        <Button Content="✕" Click="BtnRemoveActionGroup_Click"
                                                Padding="4,0" Tag="{Binding}"
                                                MinWidth="40" MinHeight="40" VerticalAlignment="Center"
                                                ToolTip="{x:Static props:AutomationStrings.AutoWf_Delete}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
        </Grid>

<GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                        DragStarted="Splitter_DragStarted"/>

<!-- ==================== 右侧：内容区域 ==================== -->
        <Grid Grid.Column="2" x:Name="DetailHost" ClipToBounds="True">

            <!-- ========== 工作流编辑器面板 ========== -->
            <ScrollViewer x:Name="WorkflowEditorPanel" Visibility="Collapsed" Padding="16,8">
                <StackPanel DataContext="{Binding SelectedWorkflow, Mode=OneWay}">
                    <!-- 禁用时整体半透明 -->
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActionSet.IsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.56"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- ===== 顶部：名称 + 选项 ===== -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_Name}" FontWeight="Medium" Margin="0,0,0,4"/>
                                <TextBox x:Name="TextBoxWorkflowName"
                                         Padding="8,6" MinWidth="200"
                                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                         BorderThickness="1"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                                <CheckBox x:Name="CheckBoxIsRevertEnabled" Content="{x:Static props:AutomationStrings.AutoWf_EnableRevert}" Margin="0,0,0,8"
                                          Checked="CheckBoxIsRevertEnabled_Changed"
                                          Unchecked="CheckBoxIsRevertEnabled_Changed"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnInvokeAction" Content="{x:Static props:AutomationStrings.AutoWf_Invoke}" Padding="12,4" Margin="0,0,8,0" Click="BtnInvokeAction_Click"/>
                                    <Button x:Name="BtnRevertAction" Content="{x:Static props:AutomationStrings.AutoWf_Revert}" Padding="12,4" Click="BtnRevertAction_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== 触发器编辑区 ===== -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- 标题 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Important_20_Regular}" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_WhenEvents}" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 触发器列表 -->
                            <ItemsControl x:Name="TriggersItemsControl" Margin="0,0,0,8"
                                          dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True"
                                          touch:TouchAwareDragDropHelper.IsEnabled="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="4" Padding="8" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 拖动按钮 -->
                                                <Border Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                                        Background="Transparent" Padding="2,4" Margin="0,0,4,0"
                                                        Cursor="SizeAll">
                                                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ReOrderDotsVertical_20_Filled}" FontSize="10"
                                                               VerticalAlignment="Center" Opacity="0.45"/>
                                                </Border>

                                                <!-- 删除按钮 -->
                                                <Button Grid.Column="1" Content="✕" Padding="4,0"
                                                        Margin="0,0,8,0" Click="BtnRemoveTrigger_Click"
                                                        MinWidth="40" MinHeight="40" VerticalAlignment="Center"
                                                        Tag="{Binding}" ToolTip="{x:Static props:AutomationStrings.AutoWf_Delete}"/>

                                                <!-- 触发器类型选择 -->
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{x:Static local:AutomationWorkflowPage.RegisteredTriggersList}"
                                                          DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                          SelectedValue="{Binding Id, Mode=TwoWay}"
                                                          SelectionChanged="ComboBoxTriggerType_SelectionChanged"
                                                          Tag="{Binding}" Padding="8,6" MinWidth="150"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 添加触发器 -->
                            <Button Content="{x:Static props:AutomationStrings.AutoWf_AddTrigger}" Click="BtnAddTrigger_Click"
                                    Padding="12,6" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== 条件编辑区（规则集） ===== -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:ToggleSwitch x:Name="ToggleIsConditionEnabled" Margin="0,0,8,0"
                                             Toggled="ToggleIsConditionEnabled_Toggled"/>
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Tag_20_Regular}" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_AndConditions}" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 条件禁用提示 -->
                        <TextBlock x:Name="ConditionDisabledHint"
                                   Text="{x:Static props:AutomationStrings.AutoWf_ConditionDisabledHint}" Opacity="0.5" Margin="0,0,0,8"/>

                        <!-- 条件编辑面板 -->
                        <StackPanel x:Name="ConditionEditorPanel">
                            <ctrl:AutomationRulesetEditor x:Name="RulesetEditor"
                                                          SettingsChanged="RulesetEditor_SettingsChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== 行动编辑区 ===== -->
                    <ctrl:AutomationActionSetEditor x:Name="ActionSetEditor"
                                                    SettingsChanged="ActionSetEditor_SettingsChanged"/>

                    <!-- ===== 恢复提示 ===== -->
                    <StackPanel x:Name="RevertHintPanel" Orientation="Horizontal" Margin="0,0,0,16" Opacity="0.6">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Stop_20_Regular}" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_AutoRevertHint}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 状态组编辑器面板 ========== -->
            <ScrollViewer x:Name="StateGroupEditorPanel" Visibility="Collapsed" Padding="16,8">
                <StackPanel>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_Name}" FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBox x:Name="TextBoxStateGroupName"
                                     Padding="8,6" MinWidth="200" HorizontalAlignment="Left"
                                     TextChanged="TextBoxStateGroupName_TextChanged"
                                     BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                     BorderThickness="1"/>
                        </StackPanel>
                    </Border>

                    <ctrl:AutomationRulesetEditor x:Name="StateGroupRulesetEditor"
                                                  SettingsChanged="GroupSettingsChanged"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 动作组编辑器面板 ========== -->
            <ScrollViewer x:Name="ActionGroupEditorPanel" Visibility="Collapsed" Padding="16,8">
                <StackPanel>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_Name}" FontWeight="Medium" Margin="0,0,0,4"/>
                                <TextBox x:Name="TextBoxActionGroupName"
                                         Padding="8,6" MinWidth="200" HorizontalAlignment="Left"
                                         TextChanged="TextBoxActionGroupName_TextChanged"
                                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                         BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="BtnInvokeActionGroup" Content="{x:Static props:AutomationStrings.AutoWf_Invoke}" Padding="12,4" Margin="0,0,8,0" Click="BtnInvokeActionGroup_Click"/>
                                <Button x:Name="BtnRevertActionGroup" Content="{x:Static props:AutomationStrings.AutoWf_Revert}" Padding="12,4" Click="BtnRevertActionGroup_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ctrl:AutomationActionSetEditor x:Name="ActionGroupActionSetEditor"
                                                    SettingsChanged="GroupSettingsChanged"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 未选择时的占位符 ========== -->
            <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Rename_20_Regular}" FontSize="48" HorizontalAlignment="Center" Opacity="0.4"/>
                <TextBlock Text="{x:Static props:AutomationStrings.AutoWf_EmptyState}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.6"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:Page>
