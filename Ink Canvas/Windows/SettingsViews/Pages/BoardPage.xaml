<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties"
          x:Class="Ink_Canvas.Windows.SettingsViews.Pages.BoardPage"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
          xmlns:helpers="clr-namespace:Ink_Canvas.Windows.SettingsViews.Helpers"
          xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
          xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
          xmlns:dd="urn:gong-wpf-dragdrop"
          xmlns:board="clr-namespace:Ink_Canvas.Controls.Toolbar.BoardToolbar"
          xmlns:toolbar="clr-namespace:Ink_Canvas.Controls.Toolbar"
          xmlns:touch="clr-namespace:Ink_Canvas.Helpers"
          xmlns:sys="clr-namespace:System;assembly=mscorlib"
          xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
          mc:Ignorable="d"
          Title="Board">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Helpers/SharedSettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingsSectionHeaderTextBlockStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Margin" Value="1,30,0,6" />
                </Style.Setters>
            </Style>
            <!-- Toolbar converters -->
            <local:BoardIdToDisplayNameConverter x:Key="IdToNameConverter"/>
            <local:BoardIdToIconKeyConverter x:Key="IdToIconKeyConverter"/>
            <local:BoardIdToIconVisibilityConverter x:Key="IdToIconVisibilityConverter"/>
            <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <local:BoardAreaNameConverter x:Key="AreaNameConverter"/>
            <local:BoardGroupNameConverter x:Key="GroupNameConverter"/>
            <local:BoardPositionNameConverter x:Key="PositionNameConverter"/>
            <helpers:StringToGeometryConverter x:Key="StringToGeometryConverter"/>
            <local:BoardIdToPathDataConverter x:Key="IdToPathDataConverter"/>
            <!-- Menu converters -->
            <local:BoardMenuItemIdToNameConverter x:Key="MenuItemIdToNameConverter"/>
            <local:BoardMenuItemIdToPathDataConverter x:Key="MenuItemIdToPathDataConverter"/>

            <!-- Toolbar templates -->
            <DataTemplate x:Key="GroupChildItemTemplate" DataType="{x:Type board:BoardToolbarComponentEntry}">
                <Border Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:FontIcon touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                     Icon="{x:Static ui:FluentSystemIcons.ReOrder_16_Regular}" FontSize="16"
                                     Cursor="SizeAll" VerticalAlignment="Center" Margin="-6,0,0,0"
                                     RenderTransformOrigin="0.5,0.5">
                            <ui:FontIcon.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </ui:FontIcon.RenderTransform>
                        </ui:FontIcon>
                        <Grid Width="16" Height="16" Margin="2,0,4,0" VerticalAlignment="Center">
                            <Path Data="{Binding Id, Converter={StaticResource IdToPathDataConverter}}" Width="16" Height="16" Stretch="Uniform"
                                  Fill="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"
                                  Visibility="{Binding Id, Converter={StaticResource IdToIconVisibilityConverter}}"/>
                            <ui:FontIcon Icon="{Binding Id, Converter={StaticResource IdToIconKeyConverter}}" FontSize="16"
                                         Visibility="{Binding Id, Converter={StaticResource IdToIconVisibilityConverter}, ConverterParameter=fontIcon}"/>
                        </Grid>
                        <TextBlock Text="{Binding Id, Converter={StaticResource IdToNameConverter}}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <Button Click="RemoveGroupChildItem_Click"
                                x:Name="BtnRemoveGroupChild"
                                Style="{StaticResource BorderlessIconButtonStyle}"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Visibility="Collapsed">
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_16_Regular}" FontSize="16" Foreground="IndianRed"/>
                        </Button>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="ToolbarLibraryItemTemplate">
                <Border BorderThickness="0"
                        CornerRadius="6" Padding="10,8"
                        HorizontalAlignment="Stretch"
                        Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                     Icon="{x:Static ui:FluentSystemIcons.ReOrderDotsVertical_24_Filled}" FontSize="16"
                                     Cursor="SizeAll" Margin="-1,0,2,0" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{Binding Id, Converter={StaticResource IdToPathDataConverter}}" Width="20" Height="20" Stretch="Uniform"
                                  Fill="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"
                                  Visibility="{Binding Id, Converter={StaticResource IdToIconVisibilityConverter}}"/>
                            <ui:FontIcon Icon="{Binding Id, Converter={StaticResource IdToIconKeyConverter}}" FontSize="20"
                                         Visibility="{Binding Id, Converter={StaticResource IdToIconVisibilityConverter}, ConverterParameter=fontIcon}"/>
                        </Grid>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" FontSize="13"/>
                            <TextBlock Text="{Binding Description}" Opacity="0.65" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                Click="AddToolbarLibraryItem_Click" x:Name="BtnAddItem"
                                Background="Transparent" BorderThickness="0"
                                Padding="6,4" VerticalAlignment="Center"
                                ToolTip="{x:Static props:FloatingBarStrings.ToolbarPage_AddToAdded}"
                                Cursor="Hand" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="GroupEntryTemplate" DataType="{x:Type board:BoardToolbarGroupEntry}">
                <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8" Padding="8" Margin="0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                     touch:TouchAwareDragDropHelper.IsExplicitVisible="True"
                                     Icon="{x:Static ui:FluentSystemIcons.ReOrder_20_Regular}" FontSize="16"
                                     Cursor="SizeAll" Margin="-2,0,4,0" VerticalAlignment="Stretch"
                                     RenderTransformOrigin="0.5,0.5">
                            <ui:FontIcon.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </ui:FontIcon.RenderTransform>
                        </ui:FontIcon>
                        <ListView Grid.Column="1" ItemsSource="{Binding Components}"
                                  ItemTemplate="{StaticResource GroupChildItemTemplate}"
                                  dd:DragDrop.IsDragSource="True"
                                  dd:DragDrop.IsDropTarget="True"
                                  dd:DragDrop.DropHandler="{Binding DataContext.GroupDropHandler, RelativeSource={RelativeSource AncestorType=ui:Page}}"
                                  touch:TouchAwareDragDropHelper.IsEnabled="True"
                                  Background="Transparent" BorderThickness="0"
                                  SelectionChanged="GroupChildList_SelectionChanged"
                                  MinHeight="32">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                        <Border Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right"
                                Padding="4" Margin="4,0,0,0" CornerRadius="4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="InsertGroupBelow_Click" Padding="4,2" Margin="0,0,2,0"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="{x:Static props:FloatingBarStrings.BoardToolbarPage_AddGroup2}"
                                        Cursor="Hand">
                                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Add_16_Regular}" FontSize="12"/>
                                </Button>
                                <Button Click="RemoveGroup_Click" Padding="4,2"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="{x:Static props:FloatingBarStrings.BoardToolbarPage_DeleteProfile}"
                                        Cursor="Hand">
                                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_16_Regular}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Menu templates -->
            <DataTemplate x:Key="MenuItemTemplate">
                <Border Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:FontIcon touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                     Icon="{x:Static ui:FluentSystemIcons.ReOrder_16_Regular}" FontSize="16"
                                     Cursor="SizeAll" VerticalAlignment="Center" Margin="-6,0,0,0"
                                     RenderTransformOrigin="0.5,0.5">
                            <ui:FontIcon.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </ui:FontIcon.RenderTransform>
                        </ui:FontIcon>
                        <Path Data="{Binding Converter={StaticResource MenuItemIdToPathDataConverter}}"
                              Width="16" Height="16" Stretch="Uniform"
                              Fill="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}"
                              VerticalAlignment="Center" Margin="2,0,4,0"/>
                        <TextBlock Text="{Binding Converter={StaticResource MenuItemIdToNameConverter}}"
                                   VerticalAlignment="Center" FontSize="13"/>
                        <Button Click="RemoveMenuItem_Click"
                                x:Name="BtnRemoveItem"
                                Style="{StaticResource BorderlessIconButtonStyle}"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Visibility="Collapsed">
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_16_Regular}" FontSize="16" Foreground="IndianRed"/>
                        </Button>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="MenuLibraryItemTemplate">
                <Border BorderThickness="0"
                        CornerRadius="6" Padding="10,8"
                        HorizontalAlignment="Stretch"
                        Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Grid.Column="0" touch:TouchAwareDragDropHelper.IsGripHandle="True"
                                     Icon="{x:Static ui:FluentSystemIcons.ReOrderDotsVertical_24_Filled}" FontSize="16"
                                     Cursor="SizeAll" Margin="-1,0,2,0" VerticalAlignment="Center"/>
                        <Path Grid.Column="1" Data="{Binding IconGeometry, Converter={StaticResource StringToGeometryConverter}}" Width="20" Height="20" Stretch="Uniform"
                              Fill="{DynamicResource {x:Static ui:ThemeKeys.TextFillColorPrimaryBrushKey}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" FontSize="13"/>
                            <TextBlock Text="{Binding Description}" Opacity="0.65" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="3" Click="AddMenuLibraryItem_Click" x:Name="BtnAddMenuItem" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                Background="Transparent" BorderThickness="0"
                                Padding="6,4" VerticalAlignment="Center"
                                Cursor="Hand" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer PanningMode="VerticalFirst" VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,0,24,0" MinHeight="600">
            <ikw:SimpleStackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

                <!-- ========== SECTION 1: Toolbar Config Profiles ========== -->
                <TextBlock Text="{x:Static props:FloatingBarStrings.BoardToolbarPage_ConfigProfiles}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,36,0,6"/>
                <DockPanel Margin="0,0,0,4">
                    <ComboBox x:Name="ComboBoxConfigFile" SelectionChanged="ComboBoxConfigFile_SelectionChanged"
                              DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Click="ButtonRefreshConfig_Click" Style="{StaticResource BorderlessIconButtonStyle}" Padding="8,6" Margin="0,0,4,0"
                                ToolTip="{x:Static props:FloatingBarStrings.ToolbarPage_RefreshProfile}">
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowSync_16_Regular}"/>
                        </Button>
                        <Button Click="ButtonNewConfig_Click" Style="{StaticResource BorderlessIconButtonStyle}" Padding="8,6" Margin="0,0,4,0"
                                ToolTip="{x:Static props:FloatingBarStrings.ToolbarPage_NewProfile}">
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Add_16_Regular}"/>
                        </Button>
                        <Button Click="ButtonDuplicateConfig_Click" Style="{StaticResource BorderlessIconButtonStyle}" Padding="8,6" Margin="0,0,4,0"
                                ToolTip="{x:Static props:FloatingBarStrings.ToolbarPage_DuplicateProfile}">
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Copy_16_Regular}"/>
                        </Button>
                        <Button Click="ButtonDeleteConfig_Click" Style="{StaticResource BorderlessIconButtonStyle}" Padding="8,6" Margin="0,0,4,0"
                                ToolTip="{x:Static props:FloatingBarStrings.ToolbarPage_DeleteProfile}">
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_16_Regular}"/>
                        </Button>
                        <Button Click="ButtonOpenConfigFolder_Click" Style="{StaticResource BorderlessIconButtonStyle}" Padding="8,6"
                                ToolTip="{x:Static props:FloatingBarStrings.ToolbarPage_OpenConfigFolder}">
                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.FolderOpen_16_Regular}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- ========== SECTION 2: Area Selection ========== -->
                <TextBlock Text="{x:Static props:FloatingBarStrings.BoardToolbarPage_Areas}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6"/>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="RadioAreaLeft" Content="{x:Static props:FloatingBarStrings.BoardToolbarPage_LeftArea}"
                                 Checked="AreaRadioButton_Changed" Margin="0,0,16,0" FontSize="13" FontWeight="Medium"/>
                    <RadioButton x:Name="RadioAreaCenter" Content="{x:Static props:FloatingBarStrings.BoardToolbarPage_CenterArea}"
                                 Checked="AreaRadioButton_Changed" Margin="0,0,16,0" FontSize="13" FontWeight="Medium"/>
                    <RadioButton x:Name="RadioAreaRight" Content="{x:Static props:FloatingBarStrings.BoardToolbarPage_RightArea}"
                                 Checked="AreaRadioButton_Changed" FontSize="13" FontWeight="Medium"/>
                </WrapPanel>

                <!-- ========== SECTION 3: Area Groups ========== -->
                <TextBlock Text="{x:Static props:FloatingBarStrings.BoardToolbarPage_AreaGroups}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <Button Content="{x:Static props:FloatingBarStrings.BoardToolbarPage_AddGroup2}"
                        Click="ButtonAddGroup_Click" Padding="10,5" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                <Border MaxHeight="220" CornerRadius="8" Padding="6">
                    <ui:ListView x:Name="AreaGroupsControl"
                                  ItemTemplate="{StaticResource GroupEntryTemplate}"
                                  dd:DragDrop.IsDragSource="True"
                                  dd:DragDrop.IsDropTarget="True"
                                  dd:DragDrop.DropHandler="{Binding DataContext.GroupListDropHandler, RelativeSource={RelativeSource AncestorType=ui:Page}}"
                                  touch:TouchAwareDragDropHelper.IsEnabled="True"
                                  Background="Transparent" BorderThickness="0"
                                  SelectionMode="Single">
                        <ui:ListView.ItemContainerStyle>
                            <Style TargetType="ui:ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ui:ListView.ItemContainerStyle>
                        <ui:ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ui:ListView.ItemsPanel>
                    </ui:ListView>
                </Border>

                <GridSplitter Height="6" HorizontalAlignment="Stretch"
                              Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS" Margin="0,8,0,8"/>

                <!-- ========== SECTION 4: Toolbar Component Library / Settings ========== -->
                <TabControl x:Name="SettingsTabControl" Margin="0,4,0,0"
                            Style="{StaticResource {x:Static ui:ThemeKeys.TabControlPivotStyleKey}}"
                            SelectedIndex="{Binding SettingsTabIndex}">
                    <!-- Tab: Component Library -->
                    <TabItem Header="{x:Static props:FloatingBarStrings.ToolbarPage_ComponentLibrary}">
                        <ScrollViewer PanningMode="VerticalFirst" VerticalScrollBarVisibility="Auto">
                            <ikw:SimpleStackPanel Spacing="4" Margin="0,8,0,0">
                                <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_ComponentLibraryHint}"
                                           Opacity="0.65" FontSize="12" Margin="0,0,0,8"/>
                                <ui:ListView ItemsSource="{Binding AvailableItems}"
                                             ItemTemplate="{StaticResource ToolbarLibraryItemTemplate}"
                                             dd:DragDrop.IsDragSource="True"
                                             touch:TouchAwareDragDropHelper.IsEnabled="True"
                                             Background="Transparent" BorderThickness="0"
                                             SelectionMode="Single"
                                             SelectionChanged="LibraryList_SelectionChanged">
                                    <ui:ListView.ItemContainerStyle>
                                        <Style TargetType="ui:ListViewItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                            <Setter Property="Margin" Value="1.5"/>
                                            <EventSetter Event="Loaded" Handler="ToolbarListViewItem_Loaded"/>
                                        </Style>
                                    </ui:ListView.ItemContainerStyle>
                                    <ui:ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"
                                                       helpers:WrapPanelAutoResize.TargetWidth="225"/>
                                        </ItemsPanelTemplate>
                                    </ui:ListView.ItemsPanel>
                                </ui:ListView>
                            </ikw:SimpleStackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab: Component Settings -->
                    <TabItem Header="{x:Static props:FloatingBarStrings.ToolbarPage_ComponentSettings}">
                        <TabItem.Visibility>
                            <Binding Path="SelectedEntry" Converter="{StaticResource NullToVisibilityConverter}"/>
                        </TabItem.Visibility>
                        <ScrollViewer PanningMode="VerticalFirst" VerticalScrollBarVisibility="Auto">
                            <ikw:SimpleStackPanel Spacing="4" Margin="0,8,0,0">
                                <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_ComponentProperties}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_Size}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_FixedWidth}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TextBoxFixedWidth" Width="80" HorizontalAlignment="Left" TextChanged="ComponentSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_FixedHeight}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TextBoxFixedHeight" Width="80" HorizontalAlignment="Left" TextChanged="ComponentSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_MinWidth}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TextBoxMinWidth" Width="80" HorizontalAlignment="Left" TextChanged="ComponentSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_MinHeight}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TextBoxMinHeight" Width="80" HorizontalAlignment="Left" TextChanged="ComponentSetting_TextChanged"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_Appearance}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_FontSize}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TextBoxFontSize" Width="60" HorizontalAlignment="Left" TextChanged="ComponentSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_Opacity}" FontSize="12" Opacity="0.7" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TextBoxOpacity" Width="60" HorizontalAlignment="Left" TextChanged="ComponentSetting_TextChanged"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_Margin}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                <TextBlock Text="{x:Static props:FloatingBarStrings.ToolbarPage_MarginHint}" FontSize="12" Opacity="0.65" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBoxMarginLeft" Grid.Column="0" Margin="0,0,2,0" TextChanged="ComponentSetting_TextChanged"/>
                                    <TextBox x:Name="TextBoxMarginTop" Grid.Column="1" Margin="2,0,2,0" TextChanged="ComponentSetting_TextChanged"/>
                                    <TextBox x:Name="TextBoxMarginRight" Grid.Column="2" Margin="2,0,2,0" TextChanged="ComponentSetting_TextChanged"/>
                                    <TextBox x:Name="TextBoxMarginBottom" Grid.Column="3" Margin="2,0,0,0" TextChanged="ComponentSetting_TextChanged"/>
                                </Grid>

                                <Button Content="{x:Static props:FloatingBarStrings.ToolbarPage_ResetComponentSettings}" Click="ButtonResetComponentSettings_Click"
                                        Padding="12,6" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </ikw:SimpleStackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <GridSplitter Height="6" HorizontalAlignment="Stretch"
                              Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS" Margin="0,8,0,8"/>

                <!-- ========== SECTION 5: Whiteboard Display (from Appearance) ========== -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="{x:Static props:ThemeStrings.Theme_ShowTimeInWhiteboard}" Margin="0,8,0,6"/>

                <controls:LabeledSettingsCard x:Name="CardEnableTimeDisplayInWhiteboardMode"
                        Header="{x:Static props:ThemeStrings.Theme_ShowTimeInWhiteboard}"
                        Icon="{x:Static ui:SegoeFluentIcons.Pinned}"
                        SwitchName="ToggleSwitchEnableTimeDisplayInWhiteboardMode"
                        Toggled="ToggleSwitchEnableTimeDisplayInWhiteboardMode_Toggled" />

                <controls:LabeledSettingsCard x:Name="CardEnableChickenSoupInWhiteboardMode"
                        Header="{x:Static props:ThemeStrings.Theme_ShowQuoteInWhiteboard}"
                        Icon="{x:Static ui:SegoeFluentIcons.Message}"
                        SwitchName="ToggleSwitchEnableChickenSoupInWhiteboardMode"
                        Toggled="ToggleSwitchEnableChickenSoupInWhiteboardMode_Toggled" />

                <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_QuoteSource}">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.Heart}" />
                    </ui:SettingsCard.HeaderIcon>
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ComboBoxChickenSoupSource"
                                  SelectionChanged="ComboBoxChickenSoupSource_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuoteSource_OsuQuotes}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuoteSource_Mottos}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuoteSource_GaokaoBless}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuoteSource_Hitokoto}" />
                            <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuoteSource_PhigrosTips}" />
                        </ComboBox>
                        <Button x:Name="BtnHitokotoCustomize" Content="{x:Static props:ThemeStrings.Theme_Splash_Custom}"
                                Padding="14,4" MinWidth="65" VerticalAlignment="Center"
                                Click="BtnHitokotoCustomize_Click"
                                Visibility="Collapsed" />
                    </ikw:SimpleStackPanel>
                </ui:SettingsCard>

                <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_QuotePosition}">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.POI}" />
                    </ui:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ComboBoxChickenSoupPosition"
                              MinWidth="180"
                              SelectionChanged="ComboBoxChickenSoupPosition_SelectionChanged">
                        <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuotePosition_TopRight}" Tag="TopRight" />
                        <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuotePosition_TopLeft}" Tag="TopLeft" />
                        <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuotePosition_BottomRight}" Tag="BottomRight" />
                        <ComboBoxItem Content="{x:Static props:ThemeStrings.Theme_QuotePosition_BottomLeft}" Tag="BottomLeft" />
                    </ComboBox>
                </ui:SettingsCard>

                <GridSplitter Height="6" HorizontalAlignment="Stretch"
                              Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS" Margin="0,8,0,8"/>

                <!-- ========== SECTION 6: Toolbar & Menu Opacity (from Appearance) ========== -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="{x:Static props:ThemeStrings.Theme_BoardToolbarOpacity}" Margin="0,8,0,6"/>

                <ui:SettingsExpander Header="{x:Static props:ThemeStrings.Theme_BoardToolbarOpacity}" IsExpanded="True">
                    <ui:SettingsExpander.HeaderIcon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.EaseOfAccess}" />
                    </ui:SettingsExpander.HeaderIcon>
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_BoardToolbarOpacityLeft}">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="BoardToolbarLeftOpacityText"
                                           VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                                <Slider x:Name="BoardToolbarLeftOpacitySlider" Minimum="0.3"
                                        Maximum="1" Width="200"
                                        IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                        TickPlacement="None" AutoToolTipPlacement="None"
                                        ValueChanged="BoardToolbarLeftOpacitySlider_ValueChanged" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_BoardToolbarOpacityCenter}">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="BoardToolbarCenterOpacityText"
                                           VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                                <Slider x:Name="BoardToolbarCenterOpacitySlider" Minimum="0.3"
                                        Maximum="1" Width="200"
                                        IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                        TickPlacement="None" AutoToolTipPlacement="None"
                                        ValueChanged="BoardToolbarCenterOpacitySlider_ValueChanged" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_BoardToolbarOpacityRight}">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="BoardToolbarRightOpacityText"
                                           VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                                <Slider x:Name="BoardToolbarRightOpacitySlider" Minimum="0.3"
                                        Maximum="1" Width="200"
                                        IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                        TickPlacement="None" AutoToolTipPlacement="None"
                                        ValueChanged="BoardToolbarRightOpacitySlider_ValueChanged" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_BoardMenuOpacity}">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.PreviewLink}" />
                    </ui:SettingsCard.HeaderIcon>
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="BoardMenuOpacityText"
                                   VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                        <Slider x:Name="BoardMenuOpacitySlider" Minimum="0.3"
                                Maximum="1" Width="200"
                                IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                TickPlacement="None" AutoToolTipPlacement="None"
                                ValueChanged="BoardMenuOpacitySlider_ValueChanged" />
                    </ikw:SimpleStackPanel>
                </ui:SettingsCard>

                <GridSplitter Height="6" HorizontalAlignment="Stretch"
                              Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS" Margin="0,8,0,8"/>

                <!-- ========== SECTION 7: Board Scale (from Appearance) ========== -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="{x:Static props:ThemeStrings.Theme_BlackboardScale80}" Margin="0,8,0,6"/>

                <ui:SettingsExpander Header="{x:Static props:ThemeStrings.Theme_BlackboardScale80}" IsExpanded="True">
                    <ui:SettingsExpander.HeaderIcon>
                        <ui:FontIcon Icon="{x:Static ui:SegoeFluentIcons.BackToWindow}" />
                    </ui:SettingsExpander.HeaderIcon>
                    <ui:SettingsExpander.Items>
                        <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_BoardScaleLeft}">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="ViewboxBlackBoardLeftScaleText"
                                           VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                                <Slider x:Name="ViewboxBlackBoardLeftScaleTransformValueSlider" Minimum="0.5"
                                        Maximum="1.5" Width="200"
                                        IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                        TickPlacement="None" AutoToolTipPlacement="None"
                                        ValueChanged="ViewboxBlackBoardLeftScaleTransformValueSlider_ValueChanged" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_BoardScaleCenter}">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="ViewboxBlackBoardCenterScaleText"
                                           VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                                <Slider x:Name="ViewboxBlackBoardCenterScaleTransformValueSlider" Minimum="0.5"
                                        Maximum="1.5" Width="200"
                                        IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                        TickPlacement="None" AutoToolTipPlacement="None"
                                        ValueChanged="ViewboxBlackBoardCenterScaleTransformValueSlider_ValueChanged" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_BoardScaleRight}">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="ViewboxBlackBoardRightScaleText"
                                           VerticalAlignment="Center" FontFamily="Consolas" TextAlignment="Right"/>
                                <Slider x:Name="ViewboxBlackBoardRightScaleTransformValueSlider" Minimum="0.5"
                                        Maximum="1.5" Width="200"
                                        IsSnapToTickEnabled="True" Value="1" TickFrequency="0.05"
                                        TickPlacement="None" AutoToolTipPlacement="None"
                                        ValueChanged="ViewboxBlackBoardRightScaleTransformValueSlider_ValueChanged" />
                            </ikw:SimpleStackPanel>
                        </ui:SettingsCard>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

                <GridSplitter Height="6" HorizontalAlignment="Stretch"
                              Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS" Margin="0,8,0,8"/>

                <!-- ========== SECTION 8: Board Menu Items ========== -->
                <TextBlock Text="{x:Static props:NavStrings.Nav_BoardMenu}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,6"/>
                <TextBlock Text="配置白板工具菜单中显示的项目和顺序，最多 9 个（3×3 布局）。"
                           Opacity="0.65" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Text="已添加的菜单项" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border CornerRadius="8" Padding="6" MinHeight="58">
                    <ListView x:Name="MenuAddedList"
                              ItemTemplate="{StaticResource MenuItemTemplate}"
                              Style="{StaticResource DragDropListViewStyle}"
                              dd:DragDrop.IsDragSource="True"
                              dd:DragDrop.IsDropTarget="True"
                              dd:DragDrop.DropHandler="{Binding}"
                              touch:TouchAwareDragDropHelper.IsEnabled="True"
                              SelectionChanged="MenuAddedList_SelectionChanged"
                              MinHeight="48">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </Border>

                <GridSplitter Height="6" HorizontalAlignment="Stretch"
                              Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS" Margin="0,4,0,4"/>

                <TextBlock Text="可添加的菜单项" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,6"/>
                <ui:ListView x:Name="MenuLibraryList"
                             ItemTemplate="{StaticResource MenuLibraryItemTemplate}"
                             dd:DragDrop.IsDragSource="True"
                             touch:TouchAwareDragDropHelper.IsEnabled="True"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single"
                             SelectionChanged="MenuLibraryList_SelectionChanged">
                    <ui:ListView.ItemContainerStyle>
                        <Style TargetType="ui:ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Margin" Value="1.5"/>
                            <EventSetter Event="Loaded" Handler="MenuListViewItem_Loaded"/>
                        </Style>
                    </ui:ListView.ItemContainerStyle>
                    <ui:ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"
                                       helpers:WrapPanelAutoResize.TargetWidth="225"/>
                        </ItemsPanelTemplate>
                    </ui:ListView.ItemsPanel>
                </ui:ListView>

                <GridSplitter Height="6" HorizontalAlignment="Stretch"
                              Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Cursor="SizeNS" Margin="0,8,0,8"/>

                <!-- ========== SECTION 9: Reset Buttons ========== -->
                <Button Content="{x:Static props:FloatingBarStrings.BoardToolbarPage_ResetDefault}" Click="ButtonResetToolbar_Click"
                        Padding="20,10" HorizontalAlignment="Left" Margin="0,4,0,8"/>
                <Button Content="恢复菜单默认布局" Click="ButtonResetMenu_Click"
                        Padding="20,10" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            </ikw:SimpleStackPanel>
        </Grid>
    </ScrollViewer>
</ui:Page>
