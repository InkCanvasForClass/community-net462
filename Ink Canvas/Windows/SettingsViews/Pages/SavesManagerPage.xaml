<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties"
         x:Class="Ink_Canvas.Windows.SettingsViews.Pages.SavesManagerPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
         xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
         mc:Ignorable="d"
         Title="{x:Static props:StorageStrings.Storage_ManageSaves_Title}">

    <ui:Page.Resources>
        <!-- ItemsPresenter must be the scroll content so WPF can find its virtualizing panel. -->
        <ControlTemplate x:Key="SavesListTemplate" TargetType="ListView">
            <ui:ScrollViewerEx Focusable="False"
                               CanContentScroll="True"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               AutoHideScrollBars="{DynamicResource AutoHideScrollBars}"
                               Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}">
                <ItemsPresenter />
            </ui:ScrollViewerEx>
        </ControlTemplate>
        <ControlTemplate x:Key="PresentationListTemplate" TargetType="ListView">
            <ui:ScrollViewerEx Focusable="False" CanContentScroll="True"
                               HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Auto"
                               AutoHideScrollBars="{DynamicResource AutoHideScrollBars}">
                <ItemsPresenter />
            </ui:ScrollViewerEx>
        </ControlTemplate>
    </ui:Page.Resources>

    <Grid Margin="56,0,56,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="HeaderHost" Margin="0,20,0,12" HorizontalContentAlignment="Stretch">
            <Grid x:Name="SavesHeader" TextElement.FontSize="20" TextElement.FontWeight="SemiBold">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="NavigationBack" Width="40" Height="40" Margin="0,0,8,0"
                        VerticalAlignment="Top" Click="NavigationBack_Click"
                        ToolTip="{x:Static props:StorageStrings.Storage_ManageSaves_BackToStorage}"
                        AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowLeft_20_Regular}" FontSize="20" />
                </Button>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:HyperlinkButton x:Name="StorageBreadcrumb" Padding="4,8" FontSize="20"
                                        Foreground="{DynamicResource SettingsPageForeground}"
                                        Content="{x:Static props:StorageStrings.Storage_Title}"
                                        Click="StorageBreadcrumb_Click" />
                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ChevronRight_20_Regular}"
                                 FontSize="14" Margin="8,0" VerticalAlignment="Center" Opacity="0.6" />
                    <ui:HyperlinkButton x:Name="ManagerBreadcrumb" Padding="4,8" FontSize="20"
                                        Foreground="{DynamicResource SettingsPageForeground}"
                                        Content="{x:Static props:StorageStrings.Storage_ManageSaves_Title}"
                                        ToolTip="{x:Static props:StorageStrings.Storage_ManageSaves_BackToCategories}"
                                        Visibility="Collapsed" Click="InkBack_Click" />
                    <TextBlock x:Name="ManagerTitle" Margin="4,8"
                               Text="{x:Static props:StorageStrings.Storage_ManageSaves_Title}" />
                    <ui:FontIcon x:Name="CategoryChevron" Icon="{x:Static ui:FluentSystemIcons.ChevronRight_20_Regular}"
                                 FontSize="14" Margin="8,0" VerticalAlignment="Center" Opacity="0.6" Visibility="Collapsed" />
                    <TextBlock x:Name="InkCategoryTitle" Margin="4,8" Visibility="Collapsed" />
                </WrapPanel>
            </Grid>
        </ContentControl>

        <Grid x:Name="CategoryContent" Grid.Row="1" Margin="0,4,0,0">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <Grid x:Name="InkRoot">
                    <ikw:SimpleStackPanel x:Name="InkCategories" Spacing="8" Margin="0,10,0,0">
                        <ui:SettingsCard x:Name="PresentationCategoryCard"
                                         Header="{x:Static props:StorageStrings.Storage_ManageSaves_CleanPresentations}"
                                         Description="{x:Static props:StorageStrings.Storage_ManageSaves_CleanPresentations_Desc}"
                                         IsClickEnabled="True" Click="InkCategory_Click"
                                         Tag="{x:Static local:SavesInkCategory.Presentations}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.SlideMultiple_20_Regular}" FontSize="24" />
                            </ui:SettingsCard.HeaderIcon>
                        </ui:SettingsCard>
                        <ui:SettingsCard x:Name="WhiteboardCategoryCard"
                                         Header="{x:Static props:StorageStrings.Storage_ManageSaves_CleanWhiteboard}"
                                         Description="{x:Static props:StorageStrings.Storage_ManageSaves_CleanWhiteboard_Desc}"
                                         IsClickEnabled="True" Click="InkCategory_Click"
                                         Tag="{x:Static local:SavesInkCategory.Whiteboard}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Whiteboard_20_Regular}" FontSize="24" />
                            </ui:SettingsCard.HeaderIcon>
                        </ui:SettingsCard>
                        <ui:SettingsCard x:Name="ManualCategoryCard"
                                         Header="{x:Static props:StorageStrings.Storage_ManageSaves_CleanManual}"
                                         Description="{x:Static props:StorageStrings.Storage_ManageSaves_CleanManual_Desc}"
                                         IsClickEnabled="True" Click="InkCategory_Click"
                                         Tag="{x:Static local:SavesInkCategory.Manual}">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Save_20_Regular}" FontSize="24" />
                            </ui:SettingsCard.HeaderIcon>
                        </ui:SettingsCard>
                        <ui:SettingsCard x:Name="ScreenshotCategoryCard"
                                         Header="{x:Static props:StorageStrings.Storage_ManageSaves_CleanScreenshots}"
                                         Description="{x:Static props:StorageStrings.Storage_ManageSaves_CleanScreenshots_Desc}"
                                         IsClickEnabled="True" Click="ScreenshotCategory_Click">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Image_20_Regular}" FontSize="24" />
                            </ui:SettingsCard.HeaderIcon>
                        </ui:SettingsCard>
                    </ikw:SimpleStackPanel>

                    <Grid x:Name="InkDetails" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox x:Name="InkSelectAll"
                                      MinWidth="0" Margin="0,0,8,8"
                                      Content="{x:Static props:StorageStrings.Storage_ManageSaves_SelectAll}"
                                      VerticalAlignment="Center"
                                      Checked="InkSelectAll_Changed"
                                      Unchecked="InkSelectAll_Changed" />
                            <Button x:Name="InkDelete" Margin="0,0,8,8" Content="{x:Static props:StorageStrings.Storage_ManageSaves_DeleteSelected}" Click="InkDelete_Click" />
                            <Button x:Name="InkRefresh" Margin="0,0,8,8" Content="{x:Static props:StorageStrings.Storage_Refresh}" Click="InkRefresh_Click" />
                            <Button x:Name="InkOpenFolder" Margin="0,0,8,8" Content="{x:Static props:StorageStrings.Storage_ManageSaves_OpenFolder}" Click="InkOpenFolder_Click" />
                            <ComboBox x:Name="InkSort" Margin="0,0,8,8" VerticalAlignment="Center" SelectionChanged="InkSort_SelectionChanged">
                                <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_ModifiedDesc}" Tag="ModifiedText|desc"/>
                                <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_ModifiedAsc}" Tag="ModifiedText|asc"/>
                                <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_CreatedDesc}" Tag="CreatedText|desc"/>
                                <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_CreatedAsc}" Tag="CreatedText|asc"/>
                                <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_NameAsc}" Tag="FileName|asc"/>
                                <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_NameDesc}" Tag="FileName|desc"/>
                                <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_SizeDesc}" Tag="SizeText|desc"/>
                                <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_SizeAsc}" Tag="SizeText|asc"/>
                                <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_TypeAsc}" Tag="TypeLabel|asc"/>
                            </ComboBox>
                            <TextBlock x:Name="InkCount" Margin="0,0,0,8" VerticalAlignment="Center" Opacity="0.7" />
                        </WrapPanel>

                        <ListView x:Name="InkList"
                                  Grid.Row="1"
                                  Template="{StaticResource SavesListTemplate}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  Foreground="{DynamicResource SettingsPageForeground}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}">
                                    <Setter Property="ToolTip" Value="{Binding FilePath}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="48" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColSelect}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          MinWidth="0" MinHeight="0"
                                                          HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="300" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColName}" DisplayMemberBinding="{Binding FileName}" />
                                    <GridViewColumn Width="70" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColType}" DisplayMemberBinding="{Binding TypeLabel}" />
                                    <GridViewColumn Width="80" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColSize}" DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Width="140" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColModified}" DisplayMemberBinding="{Binding ModifiedText}" />
                                    <GridViewColumn Width="140" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColCreated}" DisplayMemberBinding="{Binding CreatedText}" />
                                    <GridViewColumn Width="90" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColActions}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Padding="8,2" Content="{x:Static props:StorageStrings.Storage_ManageSaves_Reveal}" Click="Reveal_Click" Tag="{Binding}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <ListView x:Name="PresentationList" Grid.Row="1" Visibility="Collapsed"
                                  Template="{StaticResource PresentationListTemplate}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  Foreground="{DynamicResource SettingsPageForeground}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="ToolTip" Value="{Binding FilePath}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ui:SettingsCard Header="{Binding FileName}">
                                        <ui:SettingsCard.HeaderIcon>
                                            <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.SlideMultiple_20_Regular}" FontSize="24" />
                                        </ui:SettingsCard.HeaderIcon>
                                        <ui:SettingsCard.Description>
                                            <WrapPanel>
                                                <TextBlock Text="{x:Static props:StorageStrings.Storage_ManageSaves_ColSize}" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding SizeText}" Margin="0,0,16,0" />
                                                <TextBlock Text="{x:Static props:StorageStrings.Storage_ManageSaves_ColModified}" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding ModifiedText}" />
                                            </WrapPanel>
                                        </ui:SettingsCard.Description>
                                        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      MinWidth="0" MinHeight="0"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding FileName}"
                                                      ToolTip="{x:Static props:StorageStrings.Storage_ManageSaves_ColSelect}" />
                                            <Button Content="{x:Static props:StorageStrings.Storage_ManageSaves_OpenFolder}"
                                                    Click="Reveal_Click" Tag="{Binding}" />
                                        </ikw:SimpleStackPanel>
                                    </ui:SettingsCard>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="InkEmpty" Grid.Row="1"
                                   Text="{x:Static props:StorageStrings.Storage_ManageSaves_Empty}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                    </Grid>
                </Grid>
                <Grid x:Name="ShotDetails" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox x:Name="ShotSelectAll"
                                  MinWidth="0" Margin="0,0,8,8"
                                  Content="{x:Static props:StorageStrings.Storage_ManageSaves_SelectAll}"
                                  VerticalAlignment="Center"
                                  Checked="ShotSelectAll_Changed"
                                  Unchecked="ShotSelectAll_Changed" />
                        <Button x:Name="ShotDelete" Margin="0,0,8,8" Content="{x:Static props:StorageStrings.Storage_ManageSaves_DeleteSelected}" Click="ShotDelete_Click" />
                        <Button x:Name="ShotRefresh" Margin="0,0,8,8" Content="{x:Static props:StorageStrings.Storage_Refresh}" Click="ShotRefresh_Click" />
                        <Button x:Name="ShotOpenFolder" Margin="0,0,8,8" Content="{x:Static props:StorageStrings.Storage_ManageSaves_OpenFolder}" Click="ShotOpenFolder_Click" />
                        <ComboBox x:Name="ShotSort" Margin="0,0,8,8" VerticalAlignment="Center" SelectionChanged="ShotSort_SelectionChanged">
                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_ModifiedDesc}" Tag="ModifiedText|desc"/>
                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_ModifiedAsc}" Tag="ModifiedText|asc"/>
                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_CreatedDesc}" Tag="CreatedText|desc"/>
                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_CreatedAsc}" Tag="CreatedText|asc"/>
                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_NameAsc}" Tag="FileName|asc"/>
                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_NameDesc}" Tag="FileName|desc"/>
                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_SizeDesc}" Tag="SizeText|desc"/>
                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_SizeAsc}" Tag="SizeText|asc"/>
                            <ComboBoxItem Content="{x:Static props:StorageStrings.Storage_ManageSaves_Sort_TypeAsc}" Tag="TypeLabel|asc"/>
                        </ComboBox>
                        <TextBlock x:Name="ShotCount" Margin="0,0,0,8" VerticalAlignment="Center" Opacity="0.7" />
                    </WrapPanel>

                    <ListView x:Name="ShotList"
                              Grid.Row="1"
                              Template="{StaticResource SavesListTemplate}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              Foreground="{DynamicResource SettingsPageForeground}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="48" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColSelect}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      MinWidth="0" MinHeight="0"
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="300" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColName}" DisplayMemberBinding="{Binding FileName}" />
                                <GridViewColumn Width="70" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColType}" DisplayMemberBinding="{Binding TypeLabel}" />
                                <GridViewColumn Width="80" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColSize}" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Width="140" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColModified}" DisplayMemberBinding="{Binding ModifiedText}" />
                                <GridViewColumn Width="140" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColCreated}" DisplayMemberBinding="{Binding CreatedText}" />
                                <GridViewColumn Width="90" Header="{x:Static props:StorageStrings.Storage_ManageSaves_ColActions}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Padding="8,2" Content="{x:Static props:StorageStrings.Storage_ManageSaves_Reveal}" Click="Reveal_Click" Tag="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
        </Grid>
    </Grid>
</ui:Page>
